# Copy to .env in this folder (cp .env.example .env) and chmod 600 it.
# Never commit the real file: the webhook gives full CRM access.

# Required: Bitrix24 inbound webhook URL
BITRIX24_WEBHOOK_URL=

# Optional
# PORT=3055
# HOST=0.0.0.0
# LISTING_SYNC_MINUTES=15
# LISTING_COOKIE_PATH=/
# DB_PATH=./data/bookings.db
# TRUST_PROXY=1     # only behind your own reverse proxy
# COOKIE_SECURE=1
